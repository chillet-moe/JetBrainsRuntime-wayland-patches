+/*
+ * @test
+ * @bug JBR-7204
+ * @summary Same-scale image copies are pixel-exact at fractional scales
+ * @modules java.desktop/sun.awt.image
+ *          java.desktop/sun.java2d
+ * @run main/othervm -Djava.awt.headless=true SameScaleImageCopy
+ */
+
+import java.awt.Color;
+import java.awt.Graphics2D;
+import java.awt.Transparency;
+import java.awt.image.BufferedImage;
+
+import sun.awt.image.BufImgSurfaceData;
+import sun.awt.image.BufferedImageGraphicsConfig;
+import sun.awt.image.SunVolatileImage;
+import sun.java2d.SurfaceData;
+import sun.java2d.SunGraphics2D;
+
+public class SameScaleImageCopy {
+    private static final double[] SCALES = { 1.25, 1.5, 2.0, 2.5 };
+    private static final int LOGICAL_SIZE = 8;
+
+    public static void main(String[] args) {
+        for (double scale : SCALES) {
+            testScale(scale);
+        }
+    }
+
+    private static void testScale(double scale) {
+        BufferedImage template = new BufferedImage(
+                1, 1, BufferedImage.TYPE_INT_ARGB_PRE);
+        var gc = BufferedImageGraphicsConfig.getConfig(template, scale, scale);
+        var source = new SunVolatileImage(
+                gc, LOGICAL_SIZE, LOGICAL_SIZE, Transparency.TRANSLUCENT, null);
+
+        Graphics2D sourceGraphics = source.createGraphics();
+        for (int y = 0; y < LOGICAL_SIZE; y++) {
+            for (int x = 0; x < LOGICAL_SIZE; x++) {
+                sourceGraphics.setColor(((x + y) & 1) == 0
+                        ? Color.BLACK : Color.WHITE);
+                sourceGraphics.fillRect(x, y, 1, 1);
+            }
+        }
+        sourceGraphics.dispose();
+
+        BufferedImage sourcePixels = (BufferedImage)
+                ((SurfaceData) source.getDestSurface()).getDestination();
+        verifyCopy("positioned", scale, sourcePixels,
+                0, 0, 1, 1, LOGICAL_SIZE, LOGICAL_SIZE,
+                g -> g.drawImage(source, 1, 1, null));
+        verifyCopy("sized", scale, sourcePixels,
+                0, 0, 1, 1, LOGICAL_SIZE, LOGICAL_SIZE,
+                g -> g.drawImage(source,
+                        1, 1, LOGICAL_SIZE, LOGICAL_SIZE, null));
+        verifyCopy("subregion", scale, sourcePixels,
+                1, 1, 1, 1, 6, 6,
+                g -> g.drawImage(source,
+                        1, 1, 7, 7,
+                        1, 1, 7, 7,
+                        null));
+    }
+
+    private static void verifyCopy(String variant, double scale,
+                                   BufferedImage source,
+                                   int sourceX, int sourceY,
+                                   int destinationX, int destinationY,
+                                   int logicalWidth, int logicalHeight,
+                                   Drawer drawer) {
+        BufferedImage destination = new BufferedImage(
+                roundCoordinate(12 * scale),
+                roundCoordinate(12 * scale),
+                BufferedImage.TYPE_INT_ARGB_PRE);
+        SurfaceData destinationData = BufImgSurfaceData.createData(
+                destination, scale, scale);
+        Graphics2D destinationGraphics = new SunGraphics2D(
+                destinationData, Color.BLACK, Color.WHITE, null);
+        drawer.draw(destinationGraphics);
+        destinationGraphics.dispose();
+
+        int sourcePixelX = roundCoordinate(sourceX * scale);
+        int sourcePixelY = roundCoordinate(sourceY * scale);
+        int destinationPixelX = roundCoordinate(destinationX * scale);
+        int destinationPixelY = roundCoordinate(destinationY * scale);
+        int pixelWidth = roundCoordinate((sourceX + logicalWidth) * scale)
+                - sourcePixelX;
+        int pixelHeight = roundCoordinate((sourceY + logicalHeight) * scale)
+                - sourcePixelY;
+        for (int y = 0; y < pixelHeight; y++) {
+            for (int x = 0; x < pixelWidth; x++) {
+                int expected = source.getRGB(sourcePixelX + x, sourcePixelY + y);
+                int actual = destination.getRGB(
+                        destinationPixelX + x, destinationPixelY + y);
+                if (actual != expected) {
+                    throw new RuntimeException(variant + " pixel mismatch at " + x + "," + y
+                            + " at " + scale + "x scale"
+                            + ": expected 0x" + Integer.toHexString(expected)
+                            + ", got 0x" + Integer.toHexString(actual));
+                }
+            }
+        }
+    }
+
+    @FunctionalInterface
+    private interface Drawer {
+        void draw(Graphics2D graphics);
+    }
+
+    private static int roundCoordinate(double coordinate) {
+        return (int) Math.ceil(coordinate - 0.5);
+    }
+}
