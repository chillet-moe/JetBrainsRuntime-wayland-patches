+/*
+ * @test
+ * @summary Verifies fractional Wayland scale calculation from output metrics
+ * @requires os.family == "linux"
+ * @run main/othervm
+ *      --add-opens=java.desktop/sun.awt.wl=ALL-UNNAMED
+ *      -Dsun.java2d.uiScale.enabled=false
+ *      WLFractionalScaleMetrics
+ */
+
+import java.lang.reflect.Method;
+
+public class WLFractionalScaleMetrics {
+    private static final Method EFFECTIVE_SCALE_FROM;
+
+    static {
+        try {
+            Class<?> scaleUtils = Class.forName("sun.awt.wl.WLScaleUtils");
+            EFFECTIVE_SCALE_FROM = scaleUtils.getDeclaredMethod(
+                    "fromOutputMetrics", int.class,
+                    int.class, int.class, int.class, int.class);
+            EFFECTIVE_SCALE_FROM.setAccessible(true);
+        } catch (ReflectiveOperationException e) {
+            throw new ExceptionInInitializerError(e);
+        }
+    }
+
+    public static void main(String[] args) throws ReflectiveOperationException {
+        check(2.5, 3, 2560, 1440, 1024, 576);
+        check(1.25, 2, 3000, 2000, 2400, 1600);
+        check(2.0, 2, 2560, 1440, 1280, 720);
+        check(3.0, 3, 0, 1440, 1024, 576);
+        check(2.0, 2, 3840, 2160, 1280, 720);
+    }
+
+    private static void check(double expected,
+                              int displayScale,
+                              int width, int height,
+                              int widthLogical, int heightLogical)
+            throws ReflectiveOperationException {
+        double actual = (double) EFFECTIVE_SCALE_FROM.invoke(
+                null, displayScale, width, height, widthLogical, heightLogical);
+        if (Double.compare(expected, actual) != 0) {
+            throw new RuntimeException("Expected scale " + expected + ", got " + actual);
+        }
+    }
+}
