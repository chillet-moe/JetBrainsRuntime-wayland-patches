+package sun.awt.wl;
+
+final class WLScaleUtils {
+    private WLScaleUtils() {
+    }
+
+    static double fromOutputMetrics(int displayScale,
+                                    int width, int height,
+                                    int widthLogical, int heightLogical) {
+        double logicalDiagonal = Math.hypot(widthLogical, heightLogical);
+        if (width <= 0 || height <= 0 || logicalDiagonal <= 0) {
+            return displayScale;
+        }
+
+        double scale = Math.hypot(width, height) / logicalDiagonal;
+        double protocolScale = Math.rint(scale * 120.0) / 120.0;
+
+        // wl_output.scale is the preferred integer buffer scale and therefore
+        // the ceiling of the fractional scale on compositors that advertise one.
+        if (!Double.isFinite(protocolScale)
+                || protocolScale <= displayScale - 1.0
+                || protocolScale > displayScale) {
+            return displayScale;
+        }
+        return protocolScale;
+    }
+}
